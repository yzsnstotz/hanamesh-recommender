{
  "name": "hanamesh-recommender",
  "version": "0.1.1-rc.1",
  "description": "HanaMesh semantic recommendation client for DSH",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.13.1"
  },
  "packageManager": "pnpm@10.33.0",
  "main": "./dist/dsh.js",
  "exports": {
    ".": "./dist/dsh.js",
    "./client": "./dist/client-ui.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "profile",
    "docs/CONTEXT.md",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "docs/DEVKIT_SUPPLY.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "pnpm run build",
    "test": "node --test --test-reporter=tap test/*.test.mjs",
    "test:mutation": "node scripts/mutations.mjs",
    "verify:pack": "pnpm run pack:artifact && node scripts/verify-pack.mjs",
    "check": "pnpm run check:toolchain && pnpm run preflight && pnpm run build && pnpm test && pnpm run test:mutation && pnpm run verify:pack",
    "mock": "node scripts/mock-server.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "preflight": "node scripts/preflight.mjs",
    "pack:artifact": "mkdir -p artifacts && npm pack --ignore-scripts --pack-destination artifacts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.5-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.5-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.5-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.1.5-alpha.1 <0.2.0",
    "react": "18.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.5-alpha.1",
    "react": "18.3.1",
    "zod": "4.5.4",
    "@hanamesh/devkit": "git+https://github.com/yzsnstotz/hanamesh-server-shared.git#semver:^0.2.0&path:/packages/devkit"
  },
  "dsh": {
    "bundle": {
      "patch": "./profile/cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web",
      "external": [
        "react"
      ]
    }
  },
  "hanamesh": {
    "module": "recommender",
    "dshTarget": "0.1.5-alpha.1"
  }
}
